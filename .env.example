# Database Configuration for Query Interface
# Copy this file to .env and update with your actual database credentials

# Ruzivo Database Connection
RUZIVO_DB_HOST=localhost
RUZIVO_DB_PORT=3306
RUZIVO_DB_NAME=ruzivo
RUZIVO_DB_USER=root
RUZIVO_DB_PASSWORD=your_password_here

# Library Database Connection
LIBRARY_DB_HOST=localhost
LIBRARY_DB_PORT=3306
LIBRARY_DB_NAME=library
LIBRARY_DB_USER=root
LIBRARY_DB_PASSWORD=your_password_here

# Optional: Add more databases as needed
# CUSTOM_DB_HOST=localhost
# CUSTOM_DB_PORT=3306
# CUSTOM_DB_NAME=custom_db
# CUSTOM_DB_USER=root
# CUSTOM_DB_PASSWORD=your_password_here

# -----------------------------
# Flask app security & email
# -----------------------------
# Flask secret key (set to a strong random value)
SECRET_KEY=
# Password reset token salt (change this to a random string in production)
SECURITY_PASSWORD_SALT=

# SMTP configuration (use Gmail or any SMTP provider)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Set to true to avoid actually sending emails (logs instead)
MAIL_SUPPRESS_SEND=false
