# Database Configuration for Query Interface
# Copy this file to .env and update with your actual database credentials

# Ruzivo Database Connection
RUZIVO_DB_HOST=localhost
RUZIVO_DB_PORT=3306
RUZIVO_DB_NAME=ruzivo
RUZIVO_DB_USER=root
RUZIVO_DB_PASSWORD=your_password_here

# Library Database Connection
LIBRARY_DB_HOST=localhost
LIBRARY_DB_PORT=3306
LIBRARY_DB_NAME=library
LIBRARY_DB_USER=root
LIBRARY_DB_PASSWORD=your_password_here

# Optional: Add more databases as needed
# CUSTOM_DB_HOST=localhost
# CUSTOM_DB_PORT=3306
# CUSTOM_DB_NAME=custom_db
# CUSTOM_DB_USER=root
# CUSTOM_DB_PASSWORD=your_password_here

# -----------------------------
# Flask app security & email
# -----------------------------
# Flask secret key (set to a strong random value)
SECRET_KEY=
# Password reset token salt (change this to a random string in production)
SECURITY_PASSWORD_SALT=

# SMTP configuration (use Gmail or any SMTP provider)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Set to true to avoid actually sending emails (logs instead)
MAIL_SUPPRESS_SEND=false

# -----------------------------
# OpenAI
# -----------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------
# AI provider switch
# -----------------------------
# Server default: ollama | gemini | openai (subject page can override per request)
GENERATION_PROVIDER=ollama

# -----------------------------
# Ollama
# -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Optional override for lesson content generation model (falls back to OLLAMA_MODEL)
OLLAMA_CONTENT_MODEL=
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=900
GENERATION_PROGRESS_TARGET_CHARS=2600
# Optional for proxied/secured Ollama
OLLAMA_AUTHORIZATION=
OLLAMA_API_KEY=

# -----------------------------
# Google Gemini (Generative Language API)
# Set one of: GEMINI_API_KEY, GOOGLE_API_KEY, or GOOGLE_GENERATIVE_AI_API_KEY (same value from AI Studio).
# File must live next to config.py: akellodashboard/.env — restart Flask after changes.
# -----------------------------
GEMINI_API_KEY=AIzaSyBH8q3xC18l4xybtjXyR0nEMCHXHuqWWyg
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192


HELP_DESK_EMAIL=library@akello.co
HELP_DESK_EMAIL_APP_PASSWORD=wdmqpbqtpdkqsmbr

# -----------------------------
# Helpdesk email tickets (IMAP - Outlook)
# Add your Outlook email and app password here (or use HELPDESK_* in config)
