# Copy this file to `.env` in the repo root (same directory as config.py).
# Do not commit `.env` or `.flaskenv`. Restart Flask after changes.

# -----------------------------
# Flask app
# -----------------------------
SECRET_KEY=replace-with-a-long-random-value
SECURITY_PASSWORD_SALT=replace-with-a-random-salt
DATABASE_URL=sqlite:///app.db
FLASK_DEBUG=0
SESSION_LIFETIME_DAYS=14

# CSRF: keep enabled. WTF_CSRF_CHECK_DEFAULT=false leaves legacy dashboard POSTs
# unprotected; set true only after those routes send CSRF tokens.
WTF_CSRF_ENABLED=true
WTF_CSRF_CHECK_DEFAULT=false
WTF_CSRF_TIME_LIMIT=86400

# -----------------------------
# Ruzivo / Smart Learning MySQL (used by app/database_manager.py)
# Analytics connection pools in app/routes.py currently hardcode hosts — see
# AUDIT_AND_EFFICIENCY_PLAN.md. After that fix, these names are the contract.
# -----------------------------
ASL_DB_HOST=localhost
ASL_DB_PORT=3306
ASL_DB_NAME=ruzivo_2017
ASL_DB_USER=your_user
ASL_DB_PASS=your_password_here

# -----------------------------
# Library MySQL (used by app/database_manager.py as AL_DB_*)
# Do not use RUZIVO_DB_* / LIBRARY_DB_* — those names are unused by current code.
# -----------------------------
AL_DB_HOST=localhost
AL_DB_PORT=3306
AL_DB_NAME=akello_library
AL_DB_USER=your_user
AL_DB_PASS=your_password_here

# -----------------------------
# Email / helpdesk (IMAP + SMTP)
# -----------------------------
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false

HELP_DESK_EMAIL=
HELP_DESK_EMAIL_APP_PASSWORD=
HELP_DESK_IMAP_SERVER=outlook.office365.com
HELP_DESK_IMAP_PORT=993

EMAIL_IMAP_SERVER=outlook.office365.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_SENDER_FILTER=

GOOGLE_APP_PASSWORD=
GMAIL_EMAIL_ADDRESS=
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993

# -----------------------------
# Microsoft Graph / OAuth
# Code reads MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET / MICROSOFT_TENANT_ID
# (not application_client_id).
# -----------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:5000/microsoft-callback

# -----------------------------
# OpenAI / Gemini / Ollama
# Never put live API keys in this example file.
# -----------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GENERATION_PROVIDER=ollama

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_CONTENT_MODEL=
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=900
# content_dev/routes.py also reads OLLAMA_MAX_TOKENS (not OLLAMA_NUM_PREDICT)
OLLAMA_MAX_TOKENS=1500
OLLAMA_AUTHORIZATION=
OLLAMA_API_KEY=

# -----------------------------
# Optional infra
# -----------------------------
REDIS_URL=
CACHE_TYPE=FileSystemCache
CACHE_DIR=flask_cache

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
LEARN_S3_BUCKET=

JUDGE0_API_URL=
JUDGE0_API_TOKEN=

# Web admin DDL. Keep false in production except during a controlled change.
ALLOW_WEB_MIGRATIONS=false
ALLOW_WEB_SCHEMA_CHANGES=false
ALLOW_EXTERNAL_SCHEMA_CHANGES=false
