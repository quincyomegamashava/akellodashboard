# Copy to .env and fill in real values. Never commit .env.

# -----------------------------
# External MySQL (analytics / query UI)
# Primary names used by app/database_manager.py:
#   ASL_DB_*  = Ruzivo
#   AL_DB_*   = Library
# Legacy aliases also accepted: RUZIVO_DB_* and LIBRARY_DB_*
# -----------------------------
ASL_DB_HOST=localhost
ASL_DB_PORT=3306
ASL_DB_NAME=ruzivo_2017
ASL_DB_USER=root
ASL_DB_PASS=

AL_DB_HOST=localhost
AL_DB_PORT=3306
AL_DB_NAME=akello_library
AL_DB_USER=root
AL_DB_PASS=

# Optional legacy aliases (same meaning as ASL_/AL_ above)
# RUZIVO_DB_HOST=
# RUZIVO_DB_PORT=
# RUZIVO_DB_NAME=
# RUZIVO_DB_USER=
# RUZIVO_DB_PASSWORD=
# LIBRARY_DB_HOST=
# LIBRARY_DB_PORT=
# LIBRARY_DB_NAME=
# LIBRARY_DB_USER=
# LIBRARY_DB_PASSWORD=

# -----------------------------
# Flask app security & email
# -----------------------------
# Required in production — do not leave blank there
SECRET_KEY=
SECURITY_PASSWORD_SALT=

MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false

# Help desk IMAP / SMTP (Outlook app password — keep only in .env)
HELP_DESK_EMAIL=
HELP_DESK_EMAIL_APP_PASSWORD=
# HELPDESK_IMAP_SERVER=outlook.office365.com
# HELPDESK_IMAP_PORT=993
# HELPDESK_EMAIL=
# HELPDESK_APP_PASSWORD=

# Web admin DDL / migrations (default OFF in config.py — enable locally if needed)
ALLOW_WEB_MIGRATIONS=false
ALLOW_WEB_SCHEMA_CHANGES=false
ALLOW_EXTERNAL_SCHEMA_CHANGES=false
# Edit .env / allowlisted files from Database Studio → Files (super-admin only).
# Optional: you can also enable via the in-app "Enable file edits (DB)" toggle (app_settings).
ALLOW_WEB_FILE_EDITS=false

# -----------------------------
# AI providers
# -----------------------------
GENERATION_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Caimex OpenAI-compatible gateway (Quiz Galaxy solo progression)
CAIMEX_BASE_URL=https://caimex.econetai.co.zw:2052/v1
CAIMEX_API_KEY=
CAIMEX_MODEL=caimex/auto

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_CONTENT_MODEL=
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=900
GENERATION_PROGRESS_TARGET_CHARS=2600
OLLAMA_AUTHORIZATION=
OLLAMA_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192
